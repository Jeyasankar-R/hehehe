1st-bs
<!DOCTYPE html>
<html>
<head>
    <title>Book Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body>

<div class="container mt-5">
    <h2 class="text-center">Book Store</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Book ID</th>
                <th>Book Name</th>
                <th>Author</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>101</td>
                <td>Java Programming</td>
                <td>James</td>
                <td>₹500</td>
            </tr>
            <tr>
                <td>102</td>
                <td>Web Technology</td>
                <td>John</td>
                <td>₹450</td>
            </tr>
            <tr>
                <td>103</td>
                <td>Python</td>
                <td>Guido</td>
                <td>₹600</td>
            </tr>
        </tbody>
    </table>
</div>

</body>
</html>
2nd-
<!DOCTYPE html>
<html>
<head>
    <title>SIH Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-4">
    <h2 class="text-center text-primary">
        Smart India Hackathon Registration
    </h2>

    <form class="border rounded p-4 bg-white">
        <input class="form-control mb-3" placeholder="Username">
        <input class="form-control mb-3" type="password"
               placeholder="Password">
        <input class="form-control mb-3" placeholder="Name">
        <input class="form-control mb-3" placeholder="Address">
        <input class="form-control mb-3" type="tel"
               placeholder="Phone Number">
        <input class="form-control mb-3" placeholder="Department">
        <input class="form-control mb-3" placeholder="College Name">
        <input class="form-control mb-3" placeholder="Project Title">
        <input class="form-control mb-3" placeholder="Team Member">
        <input class="form-control mb-3" type="email"
               placeholder="Email ID">

        <button type="submit" class="btn btn-primary w-100">
            Register
        </button>
    </form>
</div>

</body>
</html>
3rd -
<!DOCTYPE html>
<html>
<head>
    <title>Online Shopping</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <span class="navbar-brand">My Shopping</span>
    </div>
</nav>

<div class="container mt-4">
    <h2 class="text-center mb-4">Products</h2>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Mobile Phone</h4>
                <p>Price: ₹20,000</p>
                <button class="btn btn-primary">Buy Now</button>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Laptop</h4>
                <p>Price: ₹50,000</p>
                <button class="btn btn-primary">Buy Now</button>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Headphones</h4>
                <p>Price: ₹2,000</p>
                <button class="btn btn-primary">Buy Now</button>
            </div>
        </div>
    </div>
</div>

</body>
</html>