# app.ts

import { Component } from '@angular/core';

@Component({
  selector: 'app-root',
  standalone: true,
  templateUrl: './app.component.html',
  styleUrl: './app.component.css'
})

export class AppComponent {

  title: string = 'Student Application';

  name: string = 'Student';

  age: number = 20;

  students = [
    { name: 'Arun', age: 20 },
    { name: 'Priya', age: 21 },
    { name: 'Kumar', age: 22 }
  ];

  changeName() {
    this.title = 'Angular Application';
  }

}


#app.html

<h1>{{ title }}</h1>

<p>Name: {{ name }}</p>

<p>Age: {{ age }}</p>

<!-- Event binding -->
<button (click)="changeName()">
    Change Title
</button>

<hr>

<!-- Conditional display -->
<div *ngIf="age >= 18">
    Eligible
</div>

<hr>

<!-- Display list -->
<h2>Student Details</h2>

<ul>
    <li *ngFor="let s of students">
        {{ s.name }} - {{ s.age }}
    </li>
</ul>

<hr>

<!-- Two-way data binding -->
<input [(ngModel)]="name">

<p>Welcome {{ name }}</p>


#app.css


h1 {
    color: blue;
    text-align: center;
}

p {
    color: darkgreen;
    font-size: 18px;
}

button {
    background-color: blue;
    color: white;
    padding: 10px;
    border: none;
}

li {
    margin: 10px;
}


#commands

npm install -g @angular/cli

ng new myapp

cd myapp

ng serve